	"Dialog": [
		{
			"GroupId": "D_AhabSyndication_Casino_Intro",
			"Items": [
				{
					"Actor": "NCT_AhabSyndication_CasinoIntro",
					"Target": "NCT_AhabSyndication_CasinoOwner",
					"Side": "R",
					"Text": "The casino is owned by {1} but rumors say it is a front for the <style=DialogName>Seven Dragons</style> syndicate."
				},
				{
					"Actor": "PCP_Face",
					"Text": "<style=DialogName>Seven Dragons</style> specializes in financial crimes, don't they?"
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoIntro",
					"Side": "R",
					"Text": "Everything from extortion to counterfeiting to white-collar fraud."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoIntro",
					"Side": "R",
					"Text": "But their real strength is investment in legitimate businesses."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoIntro",
					"Side": "R",
					"Text": "They generally keep a low profile and launder their illegal proceeds through some of their businesses."
				},
				{
					"Actor": "PCP_Knight",
					"Text": "A casino would be a particularly good place to launder money, as well as a source for identifying and scoping out potential targets."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoIntro",
					"Target": "NCT_AhabSyndication_CasinoOwner",
					"Side": "R",
					"Text": "Now the owner, {1}, wants to talk to you."
				},
				{
					"Actor": "PCP_Knight",
					"Target": "NCT_AhabSyndication_CasinoOwner",
					"Text": "Let's see what {3} wants to talk about."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoOwner",
					"Target": "PCP_Knight",
					"Side": "R",
					"Text": "Hello, Hello! It's good to meet you, {1}"
				},
				{
					"Actor": "PCP_Knight",
					"Target": "NCT_AhabSyndication_CasinoOwner",
					"Text": "Hello, {6}. I've heard you want to talk to me."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoOwner",
					"Side": "R",
					"Text": "I do indeed. News of a new <style=DialogName>Cyber Knight</style> in town spreads quickly."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoOwner",
					"Side": "R", 
					"Text": "You, my friend, are going to be a mover and shaker in this city."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoOwner",
					"Side": "R",
					"Text": "I make it my business to get to know movers and shakers."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoOwner",
					"Side": "R",
					"Text": "I'd like to invite you to visit the Boston Common Casino."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoOwner",
					"Side": "R",
					"Text": "You can meet so many interesting people there. Corp Vice Presidents and Gray Cards, MilSec agents and, shall we say, less legitimate persons."
				},
				{
					"Actor": "PCP_Knight",
					"Text": "It sounds like a lot of people there would like to see me dead."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoOwner",
					"Side": "R",
					"Text": "No need to worry about security - we have a very strict policy about disputes within our walls, and plenty of enforcers."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoOwner",
					"Side": "R",
					"Text": "We have made deals across the entire Zone. The Boston Common Casino is neutral ground."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoOwner",
					"Side": "R",
					"Text": "The casino lives up to its namesake, a Common where New Boston can meet."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoOwner",
					"Target": "PCP_Knight",
					"Side": "R",
					"Text": "And we have a high-stakes game open only to the elite, the movers and shakers. People like you, {1}."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoOwner",
					"Side": "R",
					"Text": "As you might expect, the game is popular, so I could only fit you in about once a month."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoOwner",
					"Side": "R",
					"Text": "Call me if you are interested in buying into one of these game sessions. Maybe you can win the pot."
				},
				{
					"Actor": "NAR_",
					"Target": "NCT_AhabSyndication_CasinoOwner",
					"Text": "We can find {1} in our Contact list to check out what additional services and offerings {3} may be able to provide."
				},
				{
					"Actor": "NAR_",
					"Target": "NCT_AhabSyndication_CasinoOwner",
					"Text": "To join the high-stakes game, click on the Chat box in {5} profile."
				},
				{
					"Actor": "NAR_",
					"Text": "Participation in the game is limited to no more than once a month."
				}
			]
		}
	]
}