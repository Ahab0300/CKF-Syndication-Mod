	"Dialog": [
		{
			"GroupId": "D_AhabSyndication_Casino_Intro",
			"Items": [
				{
					"Actor": "NCT_AhabSyndication_CasinoIntro",
					"Target": "NCT_AhabSyndication_CasinoOwner",
					"Side": "R",
					"Text": "The casino is owned by {1} but rumors say it is a front for the <style=DialogName>Seven Dragons</style> syndicate."
				},
				{
					"Actor": "PCP_Face",
					"Text": "<style=DialogName>Seven Dragons</style> specializes in financial crimes, don't they?"
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoIntro",
					"Side": "R",
					"Text": "Everything from extortion to counterfeiting to white-collar fraud."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoIntro",
					"Side": "R",
					"Text": "But their real strength is investment in legitimate businesses."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoIntro",
					"Side": "R",
					"Text": "They generally keep a low profile and launder their illegal proceeds through some of their businesses."
				},
				{
					"Actor": "PCP_Knight",
					"Text": "A casino would be a particularly good place to launder money, as well as a source for identifying and scoping out potential targets."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoIntro",
					"Target": "NCT_AhabSyndication_CasinoOwner",
					"Side": "R",
					"Text": "Now the owner, {1}, wants to talk to you."
				},
				{
					"Actor": "PCP_Knight",
					"Target": "NCT_AhabSyndication_CasinoOwner",
					"Text": "Let's see what {3} wants to talk about."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoOwner",
					"Target": "PCP_Knight",
					"Side": "R",
					"Text": "Hello, Hello! It's good to meet you, {1}"
				},
				{
					"Actor": "PCP_Knight",
					"Target": "NCT_AhabSyndication_CasinoOwner",
					"Text": "Hello, {6}. I've heard you want to talk to me."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoOwner",
					"Side": "R",
					"Text": "I do indeed. News of a new <style=DialogName>Cyber Knight</style> in town spreads quickly."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoOwner",
					"Side": "R", 
					"Text": "You, my friend, are going to be a mover and shaker in this city."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoOwner",
					"Side": "R",
					"Text": "I make it my business to get to know movers and shakers."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoOwner",
					"Side": "R",
					"Text": "I'd like to invite you to visit the Boston Common Casino."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoOwner",
					"Side": "R",
					"Text": "You can meet so many interesting people there. Corp Vice Presidents and Gray Cards, MilSec agents and, shall we say, less legitimate persons."
				},
				{
					"Actor": "PCP_Knight",
					"Text": "It sounds like a lot of people there would like to see me dead."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoOwner",
					"Side": "R",
					"Text": "No need to worry about security - we have a very strict policy about disputes within our walls, and plenty of enforcers."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoOwner",
					"Side": "R",
					"Text": "We have made deals across the entire Zone. The Boston Common Casino is neutral ground."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoOwner",
					"Side": "R",
					"Text": "The casino lives up to its namesake, a Common where New Boston can meet."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoOwner",
					"Target": "PCP_Knight",
					"Side": "R",
					"Text": "And we have a high-stakes game open only to the elite, the movers and shakers. People like you, {1}."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoOwner",
					"Side": "R",
					"Text": "As you might expect, the game is popular, so I could only fit you in about once a month."
				},
				{
					"Actor": "NCT_AhabSyndication_CasinoOwner",
					"Side": "R",
					"Text": "Call me if you are interested in buying into one of these game sessions. Maybe you can win the pot."
				},
				{
					"Actor": "NAR_",
					"Target": "NCT_AhabSyndication_CasinoOwner",
					"Text": "We can find {1} in our Contact list to check out what additional services and offerings {3} may be able to provide."
				},
				{
					"Actor": "NAR_",
					"Target": "NCT_AhabSyndication_CasinoOwner",
					"Text": "To join the high-stakes game, click on the Chat box in {5} profile."
				},
				{
					"Actor": "NAR_",
					"Text": "Participation in the game is limited to no more than once a month."
				}
			]
		},
		{
			"GroupId": "D_AhabSyndication_Casino_Offer",
			"Items": [
				{
					"Actor": "NTG_Mem_AhabSyndication_CasinoOwner",
					"Target": "PCP_Knight",
					"Side": "R",
					"Text": "{1}! Come in and welcome!"
				},
				{
					"Actor": "NTG_Mem_AhabSyndication_CasinoOwner",
					"Side": "R",
					"Text": "I can match you up with one of our high-stakes games."
				},
				{
					"Actor": "NTG_Mem_AhabSyndication_CasinoOwner",
					"Side": "R",
					"Text": "How large a stake would you like to place in the game?"
				},
				{
					"Actor": "NAR_",
					"Text": "The game will take some time, along with cautious travel time. The <style=DialogName>Cyber Knight</style> will be unavailable for 24 hours while playing."
				}
			]
		},
		{
			"GroupId": "D_AhabSyndication_Casino_Delay",
			"Items": [
				{
					"Actor": "PCP_Knight",
					"Text": "I'm just looking around today."
				}
			]
		},
		{
			"GroupId": "D_AhabSyndication_Casino_Choices",
			"Items": [
				{
					"Actor": "NTG_Mem_AhabSyndication_CasinoOwner",
					"Side": "R",
					"Text": "Excellent! Come right this way."
				}
			]
		},
		{
			"GroupId": "D_AhabSyndication_Casino_GameStart",
			"Items": [
				{
					"Actor": "NAR_",
					"PreState1": "EQL_100_Temp_AhabSyndication_Casino_Stake",
					"Text": "<style=DialogTerm>$100k has been withdrawn from your account.</style>"
				},
				{
					"Actor": "NAR_",
					"PreState1": "EQL_200_Temp_AhabSyndication_Casino_Stake",
					"Text": "<style=DialogTerm>$200k has been withdrawn from your account.</style>"
				},
				{
					"Actor": "NAR_",
					"PreState1": "EQL_400_Temp_AhabSyndication_Casino_Stake",
					"Text": "<style=DialogTerm>$400k has been withdrawn from your account.</style>"
				},
				{
					"Actor": "NAR_",
					"PreState1": "EQL_800_Temp_AhabSyndication_Casino_Stake",
					"Text": "<style=DialogTerm>$800k has been withdrawn from your account.</style>"
				},
				{
					"Actor": "NAR_",
					"Text": "Any winnings will be deposited in 24 hours, after the game."
				}
			]
		},
		{
			"GroupId": "D_AhabSyndication_Casino_PlayingGame",
			"Items": [
				{
					"Actor": "PCP_Knight",
					"Text": "The game isn't over yet."
				}
			]
		},
		{
			"GroupId": "D_AhabSyndication_Casino_Results",
			"Items": [
				{
					"Actor": "PCP_Knight",
					"Text": "The game is over."
				}
			]
		},
		{
			"GroupId": "D_AhabSyndication_Casino_EndGame",
			"Items": [
				{
					"Actor": "NTG_Mem_AhabSyndication_CasinoOwner",
					"Side": "R",
					"Text": "I hope you enjoyed the game!"
				},
				{
					"Actor": "PCP_Knight",
					"PreState1": "LTE_3_Temp_AhabSyndication_Casino_WinState",
					"Text": "You win some, you lose some."
				},
				{
					"Actor": "PCP_Knight",
					"PreState1": "EQL_4_Temp_AhabSyndication_Casino_WinState",
					"Text": "That was a lot of fun. Thank you."
				},
				{
					"Actor": "PCP_Knight",
					"PreState1": "EQL_5_Temp_AhabSyndication_Casino_WinState",
					"Text": "That was a lot of fun! Thank you."
				},
				{
					"Actor": "PCP_Knight",
					"PreState1": "EQL_6_Temp_AhabSyndication_Casino_WinState",
					"Text": "An excellent game. I'll be back."
				},
				{
					"Actor": "PCP_Knight",
					"PreState1": "EQL_7_Temp_AhabSyndication_Casino_WinState",
					"Text": "Best game ever!"
				},
				{
					"Actor": "NAR_",
					"PreState1": "LTE_1_Temp_AhabSyndication_Casino_WinState",
					"Text": "You lost everything. Next time will be better."
				},
				{
					"Actor": "NAR_",
					"PreState1": "EQL_2_Temp_AhabSyndication_Casino_WinState",
					"Text": "You lost half your stake before pulling out."
				},
				{
					"Actor": "NAR_",
					"PreState1": "EQL_3_Temp_AhabSyndication_Casino_WinState",
					"Text": "You lost some Digitals but played well enugh."
				},
				{
					"Actor": "NAR_",
					"PreState1": "EQL_4_Temp_AhabSyndication_Casino_WinState",
					"Text": "You won some and lost some and finally broke even. Good game."
				},
				{
					"Actor": "NAR_",
					"PreState1": "EQL_5_Temp_AhabSyndication_Casino_WinState",
					"Text": "You came away with a little more than you started with. Very good."
				},
				{
					"Actor": "NAR_",
					"PreState1": "EQL_6_Temp_AhabSyndication_Casino_WinState",
					"Text": "You doubled your original stake! Time to cash out."
				},
				{
					"Actor": "NAR_",
					"PreState1": "EQL_7_Temp_AhabSyndication_Casino_WinState",
					"Text": "You swept the table and took the entire pot! That's a nice pile of Digitals!"
				},
				{
					"Actor": "NAR_",
					"PreState1": "EQL_50_Temp_AhabSyndication_Casino_Win",
