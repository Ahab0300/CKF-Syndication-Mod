	"Dialog": [
		{
			"GroupId": "D_AhabSyndication_LegRailmaster_Intro",
			"Items": [
				{
					"Actor": "PCP_Knight",
					"Target": "NCT_AhabSyndication_LegRailmaster",
					"Text": "No, we haven't heard anything. What have you heard?"
				},
				{
					"Actor": "NCT_AhabSyndication_LegRailmaster",
					"Side": "R",
					"Text": "It's hard to find any facts, but Ricksham may be setting up some kind of special sale."
				},
				{
					"Actor": "NCT_AhabSyndication_LegRailmaster",
					"Side": "R",
					"Text": "Some rare products they have come across. And the sale will have a limited audience."
				},
				{
					"Actor": "NCT_AhabSyndication_LegRailmaster",
					"Side": "R",
					"PreState1": "EQL_1_Temp_AhabSyndication_LegRailmaster_Type",
					"Text": "If they have weapons, I want to see them."
				},
				{
					"Actor": "NCT_AhabSyndication_LegRailmaster",
					"Side": "R",
					"PreState1": "EQL_2_Temp_AhabSyndication_LegRailmaster_Type",
					"Text": "I'm always looking for good gear."
				},
				{
					"Actor": "NCT_AhabSyndication_LegRailmaster",
					"Side": "R",
					"PreState1": "EQL_3_Temp_AhabSyndication_LegRailmaster_Type",
					"Text": "I'd love a new weapon for my collection."
				},
				{
					"Actor": "NCT_AhabSyndication_LegRailmaster",
					"Side": "R",
					"PreState1": "EQL_4_Temp_AhabSyndication_LegRailmaster_Type",
					"Text": "Whatever it is, I want it!"
				},
				{
					"Actor": "PCP_Face",
					"Side": "R",
					"Text": "What would you like us to do?"
				},
				{
					"Actor": "NCT_AhabSyndication_LegRailmaster",
					"Side": "R",
					"Text": "Track down the rumors. Find out who is running this sale so I can try to get in."
				},
				{
					"Actor": "NCT_AhabSyndication_LegRailmaster",
					"Side": "R",
					"Text": "Someone has to know, and I think you can find out."
				}
			]
		},
		{
			"GroupId": "D_AhabSyndication_LegRailmaster_LegStart",
			"Items": [
				{
					"Actor": "PLG_AhabSyndication_LegRailmaster",
					"Quip": "ProcLeg_AhabSyndication_LegRailmaster_Start",
					"Side": "R",
					"Text": "{11}"
				},
				{
					"Actor": "NCT_AhabSyndication_LegRailmaster",
					"Side": "R",
					"Text": "Just ask around and follow the rumors. No need for any coercion."
				},
				{
					"Actor": "NCT_AhabSyndication_LegRailmaster",
					"Side": "R",
					"Text": "Anyone who knows anything is keeping it close to their chest."
				},
				{
					"Actor": "NCT_AhabSyndication_LegRailmaster",
					"Side": "R",
					"Text": "You will have to go digging deep to find anything."
				}
			]
		},
		{
			"GroupId": "D_AhabSyndication_LegRailmaster_Chat1",
			"Items": [
				{
					"Actor": "NCT_AhabSyndication_LegRailmaster",
					"Side": "R",
					"Text": "I think it's either weapons or weapon mods."
				},
				{
					"Actor": "NCT_AhabSyndication_LegRailmaster",
					"Side": "R",
					"PreState1": "EQL_2_Temp_AhabSyndication_LegRailmaster_Type",
					"Text": "Ricksham is keeping a tight lid on any real information."
				}
			]
		},
		{
			"GroupId": "D_AhabSyndication_LegRailmaster_Chat2",
			"Items": [
				{
					"Actor": "NCT_AhabSyndication_LegRailmaster",
					"Side": "R",
					"Text": "A good question. Ricksham usually doesn't do distribution."
				},
				{
					"Actor": "PCP_Face",
					"Side": "R",
					"Text": "They pass their goods along to others to distribute."
				},
				{
					"Actor": "NCT_AhabSyndication_LegRailmaster",
					"Side": "R",
					"Text": "My guess is they have some new source and they are feeling out the market."
				}
			]
		},
		{
			"GroupId": "D_AhabSyndication_LegRailmaster_Delayed",
			"Items": [
				{
					"Actor": "NCT_AhabSyndication_LegRailmaster",
					"Target": "PCP_Knight",
					"Side": "R",
					"Quip": "ProcLeg_Generic_DelayDialog",
					"Text": "{11}"
				}
			]
		},
		{
			"GroupId": "D_AhabSyndication_LegRailmaster_Reject",
			"Items": [
				{
					"Actor": "NCT_AhabSyndication_LegRailmaster",
					"Target": "PCP_Knight",
					"Side": "R",
					"Quip": "ProcLeg_Generic_RejectDialog",
					"Text": "{11}"
				}
			]
		},
		{
			"GroupId": "D_AhabSyndication_LegRailmaster_Win",
			"Items": [
				{
					"Actor": "PTG_LegMem_AhabSyndication_LegRailmaster",
					"Text": "It took a lot of prying, and some cash to loosen tongues."
				},
				{
					"Actor": "PTG_LegMem_AhabSyndication_LegRailmaster",
					"Text": "I finally tracked the rumors down."
				},
				{
					"Actor": "PTG_LegMem_AhabSyndication_LegRailmaster",
					"Target": "NCP_AhabSyndication_Ricksham_Railmaster",
					"Text": "The person running this big sale is named {1}."
				},
				{
					"Actor": "NCT_AhabSyndication_LegRailmaster",
					"Side": "R",
					"Text": "Who is that?"
				},
				{
					"Actor": "PTG_LegMem_AhabSyndication_LegRailmaster",
					"Target": "NCP_AhabSyndication_Ricksham_Railmaster",
					"Text": "{6} is a Railmaster for Ricksham Syndicate."
				},
				{
					"Actor": "PTG_LegMem_AhabSyndication_LegRailmaster",
					"Text": "The Railmaster runs Ricksham operations in the rail yard."
				},
				{
					"Actor": "NCT_AhabSyndication_LegRailmaster",
					"Side": "R",
					"Text": "Then that's who I have to talk to."
				},
				{
					"Actor": "NCT_AhabSyndication_LegRailmaster",
					"Side": "R",
					"Text": "Thank you! I have some calls to make."
				},
				{
					"Actor": "PCP_Knight",
					"Target": "PTG_LegMem_AhabSyndication_LegRailmaster",
					"Text": "Good work, {1}."
				},
				{
					"Actor": "PTG_LegMem_AhabSyndication_LegRailmaster",
					"Side": "R",
					"Text": "Thanks. Rumors are not exactly my forte."
				},
				{
					"Actor": "PCP_Knight",
					"Target": "PTG_LegMem_AhabSyndication_LegRailmaster",
					"Text": "We may have to look into this sale ourselves."
				},
				{
					"Actor": "PCP_Knight",
					"Target": "PTG_LegMem_AhabSyndication_LegRailmaster",
					"Text": "{1}, see if you can set up a meeting."
				},
				{
					"Actor": "PTG_LegMem_AhabSyndication_LegRailmaster",
					"Target": "NCP_AhabSyndication_Ricksham_Railmaster",
					"Side": "R",
					"Text": "I'll contact {6} right away."
				},
				{
					"Actor": "NAR_",
					"Target": "NCT_AhabSyndication_LegRailmaster",
					"Quip": "Generic_Legwork_InfluenceAndFavor",
					"Text": "{11}"
				}
			]
		},
		{
			"GroupId": "D_AhabSyndication_LegRailmaster_Meeting",
			"Items": [
				{
					"Actor": "PCP_Knight",
					"Target": "NCP_AhabSyndication_Ricksham_Railmaster",
					"Text": "All right. Let's meet {1} now."
				},
				{
					"Actor": "NCP_AhabSyndication_Ricksham_Railmaster",
					"Side": "R",
					"Text": "Well, this is a surprise. A <style=DialogName>Cyber Knight</style>!"
				},
				{
					"Actor": "NCP_AhabSyndication_Ricksham_Railmaster",
					"Side": "R",
					"Text": "What brings you to the rail yards?"
				},
				{
					"Actor": "PCP_Knight",
					"Text": "We have heard that you are about to hold an exclusive sale."
				},
				{
					"Actor": "PCP_Knight",
					"Text": "We thought we would look into the rumors."
				},
				{
					"Actor": "NCP_AhabSyndication_Ricksham_Railmaster",
					"Side": "R",
					"Text": "You must have good contacts. We are keeping that quite secret."
				},
				{
					"Actor": "NCP_AhabSyndication_Ricksham_Railmaster",
					"Side": "R",
					"Text": "Yes, we are starting a special sale soon."
				},
				{
					"Actor": "NCP_AhabSyndication_Ricksham_Railmaster",
					"Side": "R",
					"Text": "We have connected with a supplier out in Phoenix making reproductions of rare weapon mods."
				},
				{
					"Actor": "PCP_Face",
					"Text": "Knock-off weapon mods?"
				},
				{
					"Actor": "NCP_AhabSyndication_Ricksham_Railmaster",
					"Side": "R",
					"Text": "These are quality goods, they just don't have the manufacturer's stamp on them."
				},
				{
					"Actor": "NCP_AhabSyndication_Ricksham_Railmaster",
					"Side": "R",
					"Text": "They clearly have a good blueprint forger and access to a decent NanoFab."
				},
				{
					"Actor": "PCP_Knight",
					"Text": "Yes, we would be interested in that."
				},
				{
					"Actor": "NCP_AhabSyndication_Ricksham_Railmaster",
